# Copy to backend/.env for local development (manage.py loads it before it picks
# the settings module). In docker/production the same names come from the container
# environment. Real environment variables always win over this file.

# Settings module. Dev: config.settings.local (DEBUG on).
# If unset, manage.py / wsgi.py / asgi.py use config.settings.production.
DJANGO_SETTINGS_MODULE=config.settings.local

# --- Secrets: REQUIRED, no defaults ----------------------------------------
# In production all three must differ (Django refuses to start otherwise).
# Use at least 32 random characters (PyJWT warns about shorter HMAC keys), e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-django-secret-key
# Signs and verifies the JWT access/refresh tokens. fastapi_app/.env needs the same value.
JWT_SIGNING_KEY=change-me-jwt-signing-key
# Bearer token FastAPI sends to Django /internal/*. fastapi_app/.env needs the same value.
INTERNAL_API_TOKEN=change-me-internal-api-token

# --- Hosts and origins: comma separated, empty by default ------------------
# localhost, 127.0.0.1 and django are always allowed on top of ALLOWED_HOSTS.
# Public site: ALLOWED_HOSTS=codebattles.online and
# CSRF_TRUSTED_ORIGINS=https://codebattles.online (plus HTTPS=1).
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# Only needed if the browser calls Django from another origin (dev: VITE_DJANGO_URL
# pointing straight at Django -> http://localhost:3000). Through the Vite proxy or
# the production entry point everything is same-origin and this stays empty.
CORS_ALLOWED_ORIGINS=

# --- Production only -------------------------------------------------------
# 0 = site is served over plain HTTP; 1 = served over TLS: secure cookies + HSTS (3600 s).
HTTPS=0

# --- Throttling (login, register, refresh, battle create) ------------------
# Number of reverse proxies between the client and Django. The throttles identify a client by IP:
# with N > 0 Django takes the N-th entry from the right of X-Forwarded-For (the entries to its
# left are client-controlled and ignored); with 0 it ignores the header and uses the socket address.
# Dev (no proxy): 0. Production chain Caddy -> web -> django: 2, compose sets it.
# Too low behind proxies: all users share one IP (one limit). Too high: clients can forge their IP.
NUM_PROXIES=0

# --- Postgres: REQUIRED except the port ------------------------------------
POSTGRES_DB=code_battles
POSTGRES_USER=code_battles
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (battle events, cache, throttling counters) ----------------------
# Required in production. config.settings.local falls back to this value.
REDIS_URL=redis://localhost:6379/0

# DEBUG, INFO, WARNING, ERROR. JSON lines go to stdout.
LOG_LEVEL=INFO
