# Copy to runner/.env. Real environment variables always win over this file.
# A missing or invalid value stops the runner at start with a message naming the variable.

# production (default) | local. production refuses the placeholder token below.
ENVIRONMENT=local

# --- Secret: REQUIRED, 32+ characters, no default --------------------------------
# FastAPI sends it as "Authorization: Bearer ..." (RUNNER_TOKEN in fastapi_app/.env must equal it).
# Anyone who has it can run code on this server: keep it out of git, use  openssl rand -hex 32
RUNNER_TOKEN=change-me-runner-token-0123456789abcdef

# --- Docker ----------------------------------------------------------------------
# Production and the compose files: the socket proxy on the internal network.
SANDBOX_DOCKER_URL=tcp://docker-proxy:2375
# A laptop without the proxy:  SANDBOX_DOCKER_URL=unix:///var/run/docker.sock
# Fixed, not negotiated: the proxy does not let GET /version through.
SANDBOX_DOCKER_API_VERSION=1.44
SANDBOX_PYTHON_IMAGE=code-battles-sandbox-python:1
SANDBOX_CPP_IMAGE=code-battles-sandbox-cpp:1

# --- Limits ----------------------------------------------------------------------
# Sandbox containers at once on the whole server (compile and run of one submission share a slot).
RUNNER_MAX_CONCURRENCY=4
# CPUs per sandbox container, 0.5 to 1.0.
SANDBOX_CPUS=1.0
# A request waits this long for a free slot, then gets 503 "busy".
RUNNER_QUEUE_TIMEOUT_SECONDS=20

# DEBUG, INFO, WARNING, ERROR. JSON lines go to stdout.
LOG_LEVEL=INFO
