# Copy to fastapi_app/.env (uvicorn is started from fastapi_app/ and reads it).
# Real environment variables always win over this file.
# A missing or invalid value stops the app at start with a message naming the variable.

# production (default): /docs, /redoc and /openapi.json are off. local: they are on.
ENVIRONMENT=local

# --- Secrets: REQUIRED, no defaults, must differ ----------------------------
# Verifies the JWT access tokens. Must equal JWT_SIGNING_KEY in backend/.env.
JWT_SIGNING_KEY=change-me-jwt-signing-key
# Bearer token for calls to Django /internal/*. Must equal INTERNAL_API_TOKEN in backend/.env.
INTERNAL_API_TOKEN=change-me-internal-api-token
# Bearer token for calls to the sandbox runner. Must equal RUNNER_TOKEN in runner/.env. A third,
# different secret: whoever has it can run code on the server.
RUNNER_TOKEN=change-me-runner-token

# --- Services --------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Internal Django API (never the public /api). In docker: http://django:8000/internal
# /ready also calls Django's /health, which sits next to /internal.
DJANGO_INTERNAL_URL=http://localhost:8000/internal
# Sandbox runner (runner/, see runner/README.md). This process runs no code and needs no Docker.
# In docker: http://runner:8000
RUNNER_URL=http://localhost:8002
# Longest wait for one verdict: queue 20 s + compile 15 s + tests 60 s, with some margin.
RUNNER_TIMEOUT_SECONDS=110

# Browser origins allowed to call this service from another origin: comma separated,
# scheme://host[:port] only, no path, no "*". Empty (default) = same-origin only.
# Dev with the Vite server calling FastAPI directly: http://localhost:3000
CORS_ALLOWED_ORIGINS=

# --- Limits (shared by all workers through Redis) ---------------------------
# Sandbox runs at the same time on the whole server (one per user on top of that).
MAX_CONCURRENT_RUNS=4
SUBMIT_COOLDOWN_SECONDS=3
WS_CONNECTS_PER_MINUTE=20

# DEBUG, INFO, WARNING, ERROR. JSON lines go to stdout.
LOG_LEVEL=INFO
