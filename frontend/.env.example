# Copy to frontend/.env.local for local development. Only VITE_* names reach the code.

# --- Dev server proxy (vite.config.ts, `npm run dev` only) -------------------------------
# /api/accounts, /api/battles -> Django; /api/tasks, /ws -> FastAPI.
VITE_PROXY_DJANGO=http://localhost:8000
VITE_PROXY_FASTAPI=http://localhost:8001

# --- API base URLs, baked into the bundle at build time ----------------------------------
# Leave empty: the browser then talks to its own origin (the dev proxy above, or the web
# entry point in production), and the WebSocket URL is built from location (ws:/wss:).
# Set them only to call the services directly from another origin; then they need CORS
# (CORS_ALLOWED_ORIGINS in backend/.env and fastapi_app/.env).
VITE_DJANGO_URL=
VITE_FASTAPI_URL=
# e.g. ws://localhost:8001 (no trailing slash)
VITE_WS_URL=
